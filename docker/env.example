# Environment variables for Docker deployment

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# Database configuration (SQLite only)
DB_URL=sqlite:///data/db.sqlite3

# Security
# run gen-secrets and paste SECRET_KEY below
SECRET_KEY=

# Application settings
DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
BOT_USERNAME=your_bot_username

# API Port (default: 8000)
API_PORT=8000

# run gen-secrets and paste INTERNAL_API_KEY below
INTERNAL_API_KEY=
LOGIN_REQUEST_TTL_SECONDS=120
REGISTRATION_TOKEN_TTL_SECONDS=1800
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_USERNAME=5
RATE_LIMIT_IP=20
CORS_ORIGINS=[]

API_BASE_URL=http://api:8000
BOT_NOTIFY_URL=http://bot:8001/notify-login
# A host proxy reaches the container from the Docker gateway (e.g. 172.17.0.1), not 127.0.0.1.
# '*' is safe only while the API port is published on 127.0.0.1 (the compose default).
FORWARDED_ALLOW_IPS=*

REFRESH_TOKEN_TTL_DAYS=30
LOGIN_HISTORY_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600

# Public browser URL (may include a proxy-stripped path prefix)
PUBLIC_URL=http://localhost:8000
SSO_COOKIE_NAME=tl_sso
# false only for plain HTTP local development
SSO_COOKIE_SECURE=true
# Optional shared parent domain; every subdomain must be trusted
SSO_COOKIE_DOMAIN=
REGISTRATION_MODE=open

# Keep the private signing key persistent and readable only by the API user.
OIDC_KEY_FILE=data/oidc-signing-key.pem
OIDC_CODE_TTL_SECONDS=60
OIDC_TOKEN_TTL_SECONDS=600
