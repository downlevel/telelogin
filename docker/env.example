# Environment variables for Docker deployment

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Database configuration (SQLite only)
DB_URL=sqlite:///data/db.sqlite3

# Security
SECRET_KEY=your_secret_key_here_minimum_32_characters_long

# Application settings
DEBUG=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
BOT_USERNAME=your_bot_username

# API Port (default: 8000)
API_PORT=8000

INTERNAL_API_KEY=replace_with_shared_random_secret_at_least_32_characters
LOGIN_REQUEST_TTL_SECONDS=120
REGISTRATION_TOKEN_TTL_SECONDS=1800
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_USERNAME=5
RATE_LIMIT_IP=20
CORS_ORIGINS=[]

API_BASE_URL=http://api:8000
BOT_NOTIFY_URL=http://bot:8001/notify-login
FORWARDED_ALLOW_IPS=127.0.0.1

REFRESH_TOKEN_TTL_DAYS=30
LOGIN_HISTORY_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600
