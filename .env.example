# Environment variables for TeleLogin

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Database URL (SQLite only)
DB_URL=sqlite:///db.sqlite3

# Security
SECRET_KEY=your_secret_key_here_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
BOT_USERNAME=your_bot_username

# Application settings
DEBUG=false

INTERNAL_API_KEY=replace_with_shared_random_secret_at_least_32_characters
LOGIN_REQUEST_TTL_SECONDS=120
REGISTRATION_TOKEN_TTL_SECONDS=1800
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_USERNAME=5
RATE_LIMIT_IP=20
CORS_ORIGINS=[]

# Local development (Docker uses the service names, see docker/env.example)
API_BASE_URL=http://localhost:8000
BOT_NOTIFY_URL=http://localhost:8001/notify-login
FORWARDED_ALLOW_IPS=127.0.0.1
API_PORT=8000

REFRESH_TOKEN_TTL_DAYS=30
LOGIN_HISTORY_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600

# Public browser URL (may include a proxy-stripped path prefix)
PUBLIC_URL=http://localhost:8000
SSO_COOKIE_NAME=tl_sso
# false only for plain HTTP local development
SSO_COOKIE_SECURE=true
# Optional shared parent domain; every subdomain must be trusted
SSO_COOKIE_DOMAIN=
REGISTRATION_MODE=open

# Keep the private signing key persistent and readable only by the API user.
OIDC_KEY_FILE=data/oidc-signing-key.pem
OIDC_CODE_TTL_SECONDS=60
OIDC_TOKEN_TTL_SECONDS=600
